<Window x:Class="Emulate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emulate" Width="1280" Height="840" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Style="{StaticResource DarkWindow}"
        Icon="pack://application:,,,/Assets/emulate.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: logo, tabs, update, settings -->
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,0">
            <DockPanel Height="52">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Image Source="pack://application:,,,/Assets/emulate.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Emulate" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdatePill" Visibility="Collapsed" Click="UpdatePill_Click" Padding="12,5" Margin="0,0,8,0"
                            Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentSoft}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="UpdatePillText" Text="Update available" Foreground="{StaticResource Accent}" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource Faint}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource Ghost}" Click="Settings_Click" ToolTip="Settings &amp; updates">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="15"/>
                    </Button>
                </StackPanel>

                <!-- Tabs -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="HomeTab" GroupName="tabs" IsChecked="True" Checked="HomeTab_Checked" Style="{DynamicResource TabStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Devices"/>
                        </StackPanel>
                    </RadioButton>
                    <ItemsControl x:Name="DeviceTabs">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="tabs" Style="{DynamicResource TabStyle}" Checked="DeviceTab_Checked" Tag="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="8" Height="8" Margin="0,0,8,0">
                                            <Ellipse Fill="{StaticResource Faint}"/>
                                            <Ellipse Fill="{StaticResource Good}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <!-- Home: OS sidebar + profiles -->
            <Grid x:Name="HomePanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="12,18">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="OPERATING SYSTEM" Style="{StaticResource Label}" Margin="12,0,0,10"/>
                        <ListBox x:Name="OsList" Style="{StaticResource NavList}" SelectionChanged="OsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{StaticResource Faint}" FontSize="12" VerticalAlignment="Center"/>
                                        <Ellipse Width="8" Height="8" Fill="{Binding Os.Accent}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Os.Name}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="48,36,48,36" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock x:Name="OsTitle" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="OsTagline" Foreground="{StaticResource Muted}" FontSize="15" Margin="0,4,0,0"/>
                        <TextBlock x:Name="OsDescription" Style="{StaticResource MutedText}" Margin="0,14,0,0" MaxWidth="680" HorizontalAlignment="Left"/>
                        <ItemsControl x:Name="OsChips" Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="9,4" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource Muted}" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="0,34,0,14">
                            <Button DockPanel.Dock="Right" Click="NewProfile_Click" Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="New profile"/>
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Profiles" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Each profile is its own device, with its own apps, accounts and photos." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <ItemsControl x:Name="ProfileList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="card" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                            CornerRadius="12" Padding="16,14" Margin="0,0,0,10" MouseLeftButtonDown="ProfileCard_MouseDown">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border CornerRadius="10" Padding="9,3" Margin="0,0,12,0" Background="#16301F"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RunningText}" Foreground="{StaticResource Good}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                                <Button Style="{StaticResource Primary}" Click="Launch_Click" Padding="14,7">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding LaunchText}"/>
                                                        <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Margin="8,1,0,0"
                                                                   Visibility="{Binding ShowLaunchChevron, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource Ghost}" Click="EditProfile_Click" ToolTip="Edit profile">
                                                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}"/>
                                                </Button>
                                                <Button Style="{StaticResource Ghost}" Click="ProfileMore_Click" ToolTip="More" Margin="0">
                                                    <TextBlock Text="&#xE712;" Style="{StaticResource Icon}"/>
                                                </Button>
                                            </StackPanel>
                                            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource Selected}" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding LastUsedText}" Foreground="{StaticResource Faint}" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="card" Property="Background" Value="{StaticResource CardHover}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="NoProfiles" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="12" Padding="24,32" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No profiles yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Create one to get your first device." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,14"/>
                                <Button Style="{StaticResource Primary}" Click="NewProfile_Click" HorizontalAlignment="Center" Margin="0">
                                    <TextBlock Text="Create a profile"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- One view per running device; kept alive while hidden so the screen isn't re-created. -->
            <Grid x:Name="DeviceViews"/>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Ghost}" Padding="8,2" Click="OpenShared_Click" ToolTip="Files here appear in every device's gallery">
                        <TextBlock Text="Shared folder" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource Ghost}" Padding="8,2" Click="OpenLogs_Click" Margin="0">
                        <TextBlock Text="Logs" FontSize="12"/>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="Ready"/>
            </DockPanel>
        </Border>
    </Grid>

    <Window.Resources>
        <Style x:Key="TabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="12,7">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Card}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Selected}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
