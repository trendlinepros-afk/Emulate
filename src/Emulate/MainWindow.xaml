<Window x:Class="Emulate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emulate" Width="1220" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Style="{StaticResource DarkWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="SettingsButton" Click="Settings_Click" Margin="0" ToolTip="Settings and updates">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Accent}" Margin="0,0,10,0">
                        <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Emulate" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Android devices on your PC, with Google Play" Foreground="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Update banner -->
        <Border Grid.Row="1" x:Name="UpdateBanner" Visibility="Collapsed" Background="#1F3358" Padding="20,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Update &amp; restart" Style="{StaticResource Primary}" Click="BannerUpdate_Click"/>
                    <Button Content="Later" Click="BannerLater_Click" Margin="0"/>
                </StackPanel>
                <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <!-- Main content: OS picker + profiles -->
        <Grid Grid.Row="2" Margin="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="9*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Text="1   Choose an Android OS"/>
                <ListBox x:Name="OsList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource CardItem}" SelectionChanged="OsList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding Os.Accent}" CornerRadius="3"/>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="5" Padding="7,2" Background="{StaticResource Line}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Os.Category}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Os.Name}" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Os.ApiLabel}" Foreground="{StaticResource Muted}" Margin="8,2,0,0" FontSize="11"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Os.Tagline}" Foreground="{Binding Os.Accent}" Margin="0,2,0,4"/>
                                    <TextBlock Text="{Binding Os.Description}" Style="{StaticResource MutedText}" FontSize="12"/>
                                    <TextBlock Text="{Binding Footer}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="NewProfile_Click" Margin="0" VerticalAlignment="Top">
                        <TextBlock Text="+ New profile"/>
                    </Button>
                    <TextBlock Style="{StaticResource H1}" x:Name="ProfilesHeader" Text="2   Choose a profile"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" Margin="0,0,0,10" FontSize="12"
                           Text="A profile is its own phone or tablet: separate apps, accounts, photos and settings. Make as many as you like."/>
                <Grid>
                    <ListBox x:Name="ProfileList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CardItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ProfileList_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Primary}" Click="Launch_Click" ToolTip="Start this device">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Launch"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="EditProfile_Click" ToolTip="Edit profile" Padding="9,6">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"/>
                                        </Button>
                                        <Button Click="ProfileMore_Click" ToolTip="More" Padding="9,6" Margin="0">
                                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets"/>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LastUsedText}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="NoProfiles" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="No profiles for this OS yet" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="Create one to get your first device." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                        <Button Style="{StaticResource Primary}" Content="+ Create a profile" Click="NewProfile_Click" HorizontalAlignment="Center" Margin="0"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- Running devices -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,10">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"
                               Text="Tip: drop photos into Pictures\Emulate Shared and they show up in every device's gallery."/>
                    <TextBlock Text="Running devices" FontWeight="SemiBold" Margin="0,0,0,6"/>
                </DockPanel>
                <TextBlock x:Name="NoDevices" Text="Nothing running. Pick an OS and a profile, then press Launch." Foreground="{StaticResource Muted}" Margin="0,2,0,4"/>
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DeviceList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Card}" CornerRadius="9" Padding="12,9" Margin="0,0,0,6" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Click="DevSendFiles_Click" ToolTip="Pick files on this PC and copy them to the device (photos go to the gallery)" IsEnabled="{Binding IsRunning}">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Send files"/></StackPanel>
                                                </Button>
                                                <Button Click="DevPull_Click" ToolTip="Copy the device's photos, screenshots and downloads to this PC" IsEnabled="{Binding IsRunning}">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Get photos"/></StackPanel>
                                                </Button>
                                                <Button Click="DevScreenshot_Click" ToolTip="Save a screenshot to Pictures\Emulate Screenshots" IsEnabled="{Binding IsRunning}" Padding="9,6">
                                                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets"/>
                                                </Button>
                                                <Button Click="DevApk_Click" ToolTip="Install an .apk file from this PC" IsEnabled="{Binding IsRunning}" Padding="9,6">
                                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"/>
                                                </Button>
                                                <Button Click="DevLocation_Click" ToolTip="Location settings" IsEnabled="{Binding IsRunning}" Padding="9,6">
                                                    <TextBlock Text="&#xE81D;" FontFamily="Segoe MDL2 Assets"/>
                                                </Button>
                                                <Button Click="DevShow_Click" ToolTip="Bring the device window to the front" IsEnabled="{Binding IsRunning}" Padding="9,6">
                                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets"/>
                                                </Button>
                                                <Button Click="DevStop_Click" Style="{StaticResource DangerBtn}" ToolTip="Shut the device down (state is saved)" Margin="0">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Stop"/></StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <Ellipse Width="10" Height="10" Fill="{Binding Accent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding OsName}" Foreground="{StaticResource Muted}" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding StateText}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding LocationText}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <ProgressBar Margin="0,8,0,0" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"
                                                     IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                                                     Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{StaticResource Bg}" Padding="20,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontSize="11">
                    <Hyperlink Click="OpenShared_Click" Foreground="{StaticResource Muted}">Shared folder</Hyperlink>
                    <Run Text="   "/>
                    <Hyperlink Click="OpenLogs_Click" Foreground="{StaticResource Muted}">Logs</Hyperlink>
                </TextBlock>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Text="Ready."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
