<Window x:Class="Emulate.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile" Width="620" SizeToContent="Height" MaxHeight="900" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource DarkWindow}">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True"/>
            <Button x:Name="SaveButton" Content="Create profile" Style="{StaticResource Primary}" IsDefault="True" Click="Save_Click" Margin="0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource H1}" Text="New profile"/>

                <StackPanel x:Name="GeneralSection">
                    <TextBlock Text="Name" Margin="0,0,0,4"/>
                    <TextBox x:Name="NameBox" Margin="0,0,0,14"/>

                    <TextBlock Text="Device type" Margin="0,0,0,4"/>
                    <ListBox x:Name="DeviceTypeList" Style="{StaticResource ChipList}" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Memory (RAM)" Margin="0,0,0,4"/>
                            <ListBox x:Name="RamList" Style="{StaticResource ChipList}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Storage" Margin="0,0,0,4"/>
                            <ListBox x:Name="StorageList" Style="{StaticResource ChipList}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Camera" Margin="0,0,0,4"/>
                    <ListBox x:Name="CameraList" Style="{StaticResource ChipList}" Margin="0,0,0,10"/>

                    <CheckBox x:Name="SyncBox" Content="Show my PC's 'Emulate Shared' folder in this device's gallery" Margin="0,0,0,14"/>
                </StackPanel>

                <TextBlock Text="Location" Margin="0,0,0,4"/>
                <ListBox x:Name="LocationList" Style="{StaticResource ChipList}" SelectionChanged="LocationList_SelectionChanged"/>
                <TextBlock x:Name="LocationHelp" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,8"/>
                <StackPanel x:Name="ManualPanel" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Latitude" Foreground="{StaticResource Muted}" FontSize="12"/>
                            <TextBox x:Name="LatBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Longitude" Foreground="{StaticResource Muted}" FontSize="12"/>
                            <TextBox x:Name="LonBox"/>
                        </StackPanel>
                        <Button Grid.Column="4" Content="Use my location" VerticalAlignment="Bottom" Click="UseMyLocation_Click" Margin="0"/>
                    </Grid>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"
                               Text="Tip: right-click a spot in Google Maps on your PC to copy its coordinates, then paste them here (you can paste 'lat, lon' into Latitude)."/>
                </StackPanel>
                <TextBlock x:Name="CurrentLocation" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
